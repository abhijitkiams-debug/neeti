# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env is intentionally committed for this project: it only
# holds a local sqlite path and a dev-only JWT fallback, no real secrets,
# and skipping it is the #1 source of "why won't it start" reports.
# .env.local / .env.production.local etc. are still ignored for any real
# per-machine or deployment secrets.
.env.local
.env.*.local
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite dev database
/prisma/*.db
/prisma/*.db-journal

# user-uploaded policy source files
/public/uploads
